# ===========================
# Root .gitignore - Product Marketing AI
# ===========================

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Environment files
.env
.env.local
.env.*.local
*.env

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===========================
# Python / Backend
# ===========================
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
.eggs/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.cache
.coverage
htmlcov/
.pytest_cache/
*.prof

# SQLite / local database (do not commit DB files)
*.db
*.sqlite
*.sqlite3

# Generated media (runtime-generated, not for source control)
backend/screenshots/
backend/media_assets/

# Alembic compiled cache
backend/alembic/__pycache__/

# ===========================
# Node.js / Frontend
# ===========================
frontend/node_modules/
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions

# Next.js build artifacts
frontend/.next/
frontend/out/
frontend/build/

# Testing
frontend/coverage/

# TypeScript build info
*.tsbuildinfo
frontend/next-env.d.ts

# Vercel
.vercel
.neon
