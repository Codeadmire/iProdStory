# ===========================
# Backend .gitignore - Python / FastAPI
# ===========================

# Virtual environment
venv/
.venv/
env/
.env/

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Distribution / packaging
*.egg
*.egg-info/
dist/
build/
.eggs/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Profiling
*.prof

# Environment / secrets
.env
.env.local
*.env

# Database files (runtime data, not source)
*.db
*.sqlite
*.sqlite3

# Runtime-generated media (screenshots and marketing assets)
screenshots/
media_assets/

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db
