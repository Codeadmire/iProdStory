# ─────────────────────────────────────────────────────────────────────────────
# Product Marketing AI — Environment Variables
# Copy this to backend/.env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="Product Marketing AI"
APP_ENV=development       # development | staging | production
DEBUG=true

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/prodmarketing

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Object Storage ────────────────────────────────────────────────────────────
STORAGE_BACKEND=local     # local | s3
LOCAL_STORAGE_PATH=./media
MEDIA_BASE_URL=http://localhost:8000/media

# S3 / MinIO (only needed when STORAGE_BACKEND=s3)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=          # For MinIO: http://minio:9000
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── AI ────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_AI_MODEL=gemini-1.5-flash-latest

# ── LinkedIn OAuth ────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback
LINKEDIN_SCOPE=openid profile email w_member_social

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=    # Leave empty to disable Sentry

# ─────────────────────────────────────────────────────────────────────────────
# Frontend (Next.js) — prefix public vars with NEXT_PUBLIC_
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
